# ── Base de données (PostgreSQL sur Render) ──
DATABASE_URL=postgresql://user:password@host/dbname

# ── Sécurité JWT ──
SECRET_KEY=change-me-with-a-very-long-random-string-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── Config appli ──
APP_NAME=Yegassi API
APP_VERSION=1.0.0
DEBUG=False
CORS_ORIGINS=["https://votre-frontend.com","http://localhost:3000"]

# ── Admin par défaut (créé au démarrage) ──
ADMIN_EMAIL=admin@yegassi.cm
ADMIN_PASSWORD=ChangeMe123!
